#!/usr/bin/env bash

die() {
  errcode=$?
  echo "error happened." >&2
  exit $errcode
}

func_rename() {
  declare -n ref=${2:-FUNC_RENAMES}
  ref+=('-e' "s/\b${1}\b/avray__$1/g")
}

makestb() {
  REMOVE_HEAD='/^\/\*\*\*/,/\*\*\*\*\//d'
  # rename functions that are "private"
  func_rename seek_to_frame
  func_rename exec_close_file
  func_rename create_mutex
  func_rename create_semaphore
  func_rename free_mutex
  func_rename free_semaphore
  func_rename semaphore_wait
  func_rename semaphore_incr
  func_rename semaphore_get_value
  func_rename mutex_lock
  func_rename mutex_unlock
  func_rename thread_create
  func_rename state_str
  func_rename switch_dec_state
  func_rename seek_command_dispatch
  func_rename free_seek_command
  func_rename make_seek_command
  func_rename close_command_dispatch
  func_rename free_close_command
  func_rename make_close_file_command
  func_rename add_command_to_q

  func_rename time_probe_seek_pts
  func_rename free_decoder_context
  func_rename feed_codec
  func_rename send_eof2codecs
  func_rename pull_frame
  func_rename signal_startup
  func_rename process_video_frame
  func_rename process_audio_frame
  func_rename init_audio_buffer
  func_rename init_swr_ifneeded
  func_rename try_unlock_decoder_sem
  func_rename try_move_to_finished_state
  func_rename seek_to_frame
  func_rename decode_thread

  func_rename cleanup_mem_fn UTIL_RENAMES
  func_rename cleanup_push_mem UTIL_RENAMES
  func_rename run_cleanups UTIL_RENAMES
  func_rename make_string UTIL_RENAMES
  func_rename free_string UTIL_RENAMES
  func_rename concat_string_chars UTIL_RENAMES
  func_rename make_ringbuffer UTIL_RENAMES
  func_rename ringbuffer_len UTIL_RENAMES
  func_rename write_to_ringbuffer UTIL_RENAMES
  func_rename write_ringbuffer_chunk_nocommit UTIL_RENAMES
  func_rename write_ringbuffer_commit UTIL_RENAMES
  func_rename read_ringbuffer_chunk UTIL_RENAMES
  func_rename read_ringbuffer UTIL_RENAMES
  func_rename free_ringbuffer UTIL_RENAMES
  func_rename ringbuffer_flush UTIL_RENAMES
  func_rename make_queue UTIL_RENAMES
  func_rename queue_add UTIL_RENAMES
  func_rename queue_pop UTIL_RENAMES
  func_rename queue_free UTIL_RENAMES

  # we can also rename some of the struct names
  func_rename String UTIL_RENAMES
  func_rename RingBuffer UTIL_RENAMES
  func_rename LinkedQueue UTIL_RENAMES

  # print license header
  echo "/*** This file was automatically generated by make_stb script."
  echo " *** Changes will not be saved. Edit source files instead and run make_stb again"
  echo " *** to regenerate this file."
  echo " ***/"
  cat <<-EOF
	/**********************************************************************************************
	*
	*   LICENSE: zlib/libpng
	*
	*   avray is licensed under an unmodified zlib/libpng license, which is an
	* OSI-certified, BSD-like license that allows static linking with closed source
	* software:
	*
	*   Copyright (c) 2026 Jagholin (github.com/Jagholin)
	*
	*   This software is provided "as-is", without any express or implied warranty.
	* In no event will the authors be held liable for any damages arising from the
	* use of this software.
	*
	*   Permission is granted to anyone to use this software for any purpose,
	* including commercial applications, and to alter it and redistribute it
	* freely, subject to the following restrictions:
	*
	*     1. The origin of this software must not be misrepresented; you must not
	* claim that you wrote the original software. If you use this software in a
	* product, an acknowledgment in the product documentation would be appreciated
	* but is not required.
	*
	*     2. Altered source versions must be plainly marked as such, and must not
	* be misrepresented as being the original software.
	*
	*     3. This notice may not be removed or altered from any source
	* distribution.
	*
	**********************************************************************************************/
	EOF
  # print header guards
  echo "#ifndef AVRAY_STB"
  echo "#define AVRAY_STB"
  sed -e "$REMOVE_HEAD" "${UTIL_RENAMES[@]}" utils.h || die
  sed -e "$REMOVE_HEAD" -e '/#include "utils.h"/d' "${UTIL_RENAMES[@]}" avlib.h || die

  # add implementation
  echo "#ifdef AVRAY_IMPLEMENTATION"
  sed -e "$REMOVE_HEAD" -e '/#include "utils.h"/d' -e '/#include "avlib.h"/d' "${FUNC_RENAMES[@]}" "${UTIL_RENAMES[@]}" avlib.c || die
  echo "#endif // AVRAY_IMPLEMENTATION"
  echo "#endif // AVRAY_STB"
}

makestb >stb_avray.h
